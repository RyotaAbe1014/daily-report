{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": [
      "es2022"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": [
      "@daily-report/source"
    ],
    "rootDir": ".",
    "paths": {
      "@daily-report/api": [
        "./packages/api/src/index.ts"
      ],
      "@daily-report/db": [
        "./packages/db/src/index.ts"
      ],
      "@daily-report/common-scripts": [
        "./packages/common/scripts/src/index.ts"
      ],
      "@daily-report/website": [
        "./packages/website/src/index.ts"
      ]
    }
  }
}
