{
  "name": "@daily-report/api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/api/src",
  "projectType": "library",
  "tags": [],
  "metadata": {
    "generator": "ts#trpc-api",
    "ports": [2022],
    "apiName": "api",
    "apiType": "trpc",
    "auth": "cognito",
    "infra": "rest-lambda",
    "integrationPattern": "isolated",
    "iac": "terraform",
    "components": [
      {
        "generator": "ts#dynamodb#trpc-connection",
        "path": "packages/db",
        "name": "@daily-report/db"
      }
    ]
  },
  "targets": {
    "assemble": {
      "dependsOn": ["compile", "bundle", "operations"]
    },
    "build": {
      "dependsOn": ["lint", "compile", "test", "bundle", "operations"]
    },
    "bundle": {
      "executor": "nx:run-commands",
      "dependsOn": ["compile"],
      "cache": true,
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/bundle"],
      "options": {
        "command": "rolldown -c rolldown.config.ts",
        "cwd": "{projectRoot}"
      }
    },
    "compile": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/tsc"],
      "options": {
        "command": "tsc --build tsconfig.lib.json",
        "cwd": "{projectRoot}"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["@daily-report/db"],
          "target": "dev"
        }
      ],
      "continuous": true,
      "options": {
        "commands": ["tsx --watch src/local-server.ts"],
        "cwd": "{projectRoot}",
        "env": {
          "LOCAL_DEV": "true"
        }
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["biome"],
      "options": {
        "command": "biome format {projectRoot}"
      },
      "configurations": {
        "fix": {
          "command": "biome format --write {projectRoot}"
        },
        "skip-lint": {
          "command": "node -e \"\""
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["biome"],
      "dependsOn": ["format"],
      "options": {
        "command": "biome lint {projectRoot}"
      },
      "configurations": {
        "fix": {
          "command": "biome check --write {projectRoot}"
        },
        "skip-lint": {
          "command": "node -e \"\""
        }
      }
    },
    "operations": {
      "cache": true,
      "inputs": ["default"],
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/packages/common/terraform/src/generated/api"
      ],
      "dependsOn": ["compile"],
      "options": {
        "commands": [
          "tsx {projectRoot}/scripts/generate-operations.ts packages/common/terraform/src/generated/api/operations.json"
        ],
        "cwd": "{workspaceRoot}"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "commands": ["tsx --watch src/local-server.ts"],
        "cwd": "{projectRoot}"
      }
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "metadata": {
        "technologies": ["vitest"],
        "description": "Run integration tests against local DynamoDB (requires Docker)"
      },
      "options": {
        "command": "vitest --config vitest.integration.config.mts",
        "cwd": "{projectRoot}"
      }
    }
  }
}
